# Option A: Your own Google OAuth app (advanced / full control)
# Create a Google Cloud OAuth client and add the redirect URI:
# http://localhost:1420/oauth/google/callback
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Option B: Built-in Sign in with Google (set by app maintainer for one-click login)
# Users do not need a .env file when this is included in the distributed app build.
VITE_BUILTIN_GOOGLE_CLIENT_ID=
