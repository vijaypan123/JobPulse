# Option A: Built-in Sign in with Google (one-click, set by app maintainer)
# Users do not need their own .env when this is included in the app build.
VITE_BUILTIN_GOOGLE_CLIENT_ID=

# Option B: Your own Google OAuth app (advanced / full control)
# Create a Google Cloud OAuth client and add the redirect URI:
# http://localhost:1420/oauth/google/callback
#
# Use OAuth client type "Desktop app" (PKCE, no secret), OR if you use
# "Web application", also set GOOGLE_CLIENT_SECRET below (server-side only).
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Optional defaults for local Ollama AI (MVP 6)
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2
